<?xml version="1.0" encoding="utf-8"?>
<!--
  Property schema for Emoji Column.
  Registered with PSRegisterPropertySchema by "EmojiColumn.exe install".
  formatID/propID must match src/Shared/Ids.cs.
-->
<schema xmlns="http://schemas.microsoft.com/windows/2006/propertydescription" schemaVersion="1.0">
  <propertyDescriptionList publisher="marco3079" product="EmojiColumn">
    <propertyDescription name="EmojiColumn.Emoji" formatID="{F95F067F-2802-4D52-BCA0-52F0C3630128}" propID="2">
      <description>Emoji tag attached to the file by Emoji Column.</description>
      <searchInfo inInvertedIndex="false" isColumn="true" columnIndexType="OnDisk" maxSize="256" />
      <labelInfo label="Emoji (text)" />
      <typeInfo type="String" isInnate="true" isViewable="true" isQueryable="true" canStackBy="true" canGroupBy="true" multipleValues="false" />
      <displayInfo displayType="String" defaultColumnWidth="8" alignment="Center">
        <drawControl control="Default" />
      </displayInfo>
    </propertyDescription>
    <!--
      Color version of the emoji. Explorer draws text without color, so this column
      uses drawControl="IconList": its value is a serialized property store pointing
      at EmojiColumn.EmojiIndex, whose <enum> entries reference the icons.
    -->
    <propertyDescription name="EmojiColumn.EmojiIcon" formatID="{F95F067F-2802-4D52-BCA0-52F0C3630128}" propID="4">
      <description>Color icon of the file's emoji (Emoji Column).</description>
      <labelInfo label="Emoji" />
      <typeInfo type="Blob" isInnate="true" isViewable="true" />
      <displayInfo defaultColumnWidth="6">
        <drawControl control="IconList" />
      </displayInfo>
    </propertyDescription>
    <!-- Generated by build.ps1 from src/Shared/EmojiPalette.cs. -->
    <propertyDescription name="EmojiColumn.EmojiIndex" formatID="{F95F067F-2802-4D52-BCA0-52F0C3630128}" propID="5">
      <description>Which color icon to draw (internal).</description>
      <labelInfo label="Emoji icon index" />
      <typeInfo type="UInt32" isInnate="true" isViewable="false" groupingRange="Enumerated" />
      <displayInfo displayType="Enumerated">
        <enumeratedList>
          <enum name="None" value="0" text="" />
          <!--EMOJI-ENUMS-->
        </enumeratedList>
      </displayInfo>
    </propertyDescription>
    <!-- The installer translates this label to the Windows UI language. -->
    <propertyDescription name="EmojiColumn.Description" formatID="{F95F067F-2802-4D52-BCA0-52F0C3630128}" propID="3">
      <description>Free-text description attached to the file by Emoji Column.</description>
      <searchInfo inInvertedIndex="false" isColumn="true" columnIndexType="OnDisk" maxSize="4096" />
      <labelInfo label="My description" />
      <typeInfo type="String" isInnate="false" isViewable="true" isQueryable="true" canStackBy="false" canGroupBy="true" multipleValues="false" />
      <displayInfo displayType="String" defaultColumnWidth="30">
        <drawControl control="Default" />
        <editControl control="Default" />
      </displayInfo>
    </propertyDescription>
  </propertyDescriptionList>
</schema>
